-	auto package = Package::CreateMemoryPackage(path);
+	// Check file size, use FilePackage for large files to avoid OOM
+	// OTA packages can be several GB, cannot fully mmap into memory
+	std::unique_ptr<Package> package;
+	struct stat st;
+	if (stat(path, &st) == 0 && st.st_size > 1536 * 1024 * 1024LL) {  // > 1.5GB
+		LOGINFO("Large file detected (%lld MB), using FilePackage\n", (long long)st.st_size / (1024 * 1024));
+		package = Package::CreateFilePackage(path, std::bind(&DataManager::SetProgress, std::placeholders::_1));
+	} else {
+		package = Package::CreateMemoryPackage(path);
+	}
 	if (!package) {
